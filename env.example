# ======================== SHARED BOT SETTINGS ========================
# Set the same DATABASE_URL on the Web Service and Background Worker.
# Replace the placeholder with the Render internal PostgreSQL URL; never commit its actual value.
DATABASE_URL=postgresql://REPLACE_WITH_RENDER_INTERNAL_DATABASE_URL

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_APPROVED=false
MARKET_LIVE_EXECUTION_ENABLED=false
PAPER_SIGNAL_SOURCE=hybrid

# ======================== WEBHOOK / BTC WORKER ========================
# Web Service only. Keep the existing webhook secret private.
GAINZALGO_WEBHOOK_SECRET=REPLACE_WITH_EXISTING_SECRET
GAINZALGO_WEBHOOK_MAX_BODY_BYTES=16384

# Use false on the Web Service when a separate Background Worker is running.
PAPER_WORKER_ENABLED=false

# Background Worker settings. Preserve your tested risk limits unless deliberately reviewed.
PAPER_WORKER_INTERVAL_SECONDS=15
PAPER_MINIMUM_SCORE=65
PAPER_MAX_ENTRY_CENTS=92
PAPER_ENTRY_TARGET_MAX_CENTS=80
PAPER_ADAPTIVE_ENTRY_TARGET_ENABLED=true
PAPER_MAX_SPREAD_CENTS=5
BTC_TREND_MONITOR_INTERVAL_SECONDS=30
BTC_TREND_MONITOR_MAX_CACHE_AGE_SECONDS=45
MAX_TRADE_DOLLARS=1.00
MAX_DAILY_LOSS_DOLLARS=10.00
# Fee-aware take-profit for simulated BTC positions. Keep it explicit and paper-only.
PAPER_TAKE_PROFIT_ENABLED=true
PAPER_TAKE_PROFIT_PERCENT=10
PAPER_TAKE_PROFIT_TRAIL_PERCENT=5
PAPER_TAKE_PROFIT_REVERSAL_EXIT_ENABLED=true
PAPER_TAKE_PROFIT_PROFIT_PROTECTION_ENABLED=true
PAPER_TAKE_PROFIT_MAJOR_MOVE_ATR_MULTIPLIER=2.5
# Pause new paper entries for one hour after four consecutive negative-net exits.
PAPER_CONSECUTIVE_LOSS_LIMIT=4
PAPER_LOSS_STREAK_COOLDOWN_MINUTES=60

# ======================== DASHBOARD CREDENTIAL VAULT ========================
# App-generated secrets supplied separately. Never commit the real values.
KALSHI_VAULT_ADMIN_SECRET=REPLACE_WITH_GENERATED_APP_SECRET
# Same stable key on Web Service and Background Worker. Do not regenerate after keys are saved.
KALSHI_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# Leave blank unless deliberately enabling the separate manual journal-write endpoints.
PAPER_ADMIN_API_SECRET=

# Public API base; set on both services only if overriding the code default.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_GET_MAX_RETRIES=4
KALSHI_MIN_REQUEST_INTERVAL_SECONDS=0.5

# ======================== MARKET INVENTORY SCANNER ========================
# Public Kalshi events include official category metadata and nested markets (max 200 events/page).
# Inventory all open-event market contracts up to explicit safety caps; cap hits show PARTIAL, never COMPLETE.
MARKET_SCANNER_AUTO_START=true
MARKET_SCAN_PAGE_SIZE=200
MARKET_SCAN_MAX_PAGES=1000
MARKET_SCAN_MAX_MARKETS=200000
MARKET_SCAN_PAGE_DELAY_SECONDS=0.05
MARKET_SCAN_PAGE_RETRIES=1
MARKET_SCAN_REFRESH_SECONDS=600
MARKET_SCAN_RETRY_SECONDS=60

# ======================== MAIN BOT: RESEARCH PIPELINE ========================
# Point to your separately deployed HTTPS provider service after deploying and validating it.
MARKET_ANALYSIS_PROVIDER_URL=
# Must be the generated shared provider token also configured on the provider service.
MARKET_ANALYSIS_PROVIDER_API_KEY=REPLACE_WITH_GENERATED_APP_TO_APP_TOKEN
MARKET_ANALYSIS_PROVIDER_TIMEOUT_SECONDS=8
# Enable only after provider setup and health/evidence validation; explicit default OFF for safety.
MARKET_ANALYSIS_AUTO_START=false
MARKET_ANALYSIS_INTERVAL_SECONDS=300
MARKET_ANALYSIS_MAX_PER_CYCLE=10
MARKET_RESEARCH_POOL_SIZE=500
MARKET_OUTCOME_MIN_AGE_MINUTES=60
MARKET_OUTCOME_RETRY_MINUTES=60
MARKET_OUTCOME_COLLECT_MAX_PER_RUN=20
# Safety gate for research paper positions; only consider true after staging validation.
MARKET_AUTOPAPER_ENABLED=false
# The dashboard autopilot master toggle also defaults OFF and must be enabled by an authenticated admin.
MARKET_PAPER_ENABLED_CATEGORIES=sports,politics,economics,weather,crypto_event,financial_markets,entertainment,companies,world,science_technology
MARKET_MIN_VOLUME_24H=50
MARKET_MIN_DEPTH_CONTRACTS=5
MARKET_MAX_SPREAD_CENTS=5
MARKET_MIN_NET_EDGE_CENTS=5
MARKET_ESTIMATED_FEE_CENTS=2
MARKET_ESTIMATED_SLIPPAGE_CENTS=1
MARKET_MAX_ENTRY_CENTS=90
MARKET_MODEL_MIN_VALIDATION_SAMPLES=100
MARKET_MODEL_MAX_BRIER_SCORE=0.22
MARKET_RESEARCH_MAX_OPEN_TRADES=20
MARKET_RESEARCH_MAX_OPEN_COST_CENTS=2000
MARKET_RESEARCH_MAX_DAILY_LOSS_CENTS=500
MARKET_RESEARCH_MAX_NEW_TRADES_PER_RUN=5

# ======================== SEPARATE HTTPS ANALYSIS PROVIDER SERVICE ========================
# Deploy this same repo as a separate Render Web Service.
# Start command: uvicorn market_analysis_provider_service:app --host 0.0.0.0 --port $PORT
# OPENAI_API_KEY must be generated in your own OpenAI Platform project; do not commit it.
# Use an account-enabled Responses API model supporting web_search and strict structured output.
# Set the same MARKET_ANALYSIS_PROVIDER_API_KEY token as the main Web Service/Worker.
# Set the same DATABASE_URL so calibration can read genuinely resolved forecast outcomes.
# Do not configure the Kalshi credential vault or any order endpoint on the analysis-only provider.
# OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_PLATFORM_API_KEY
# OPENAI_MODEL=REPLACE_WITH_ACCOUNT_ENABLED_RESPONSES_MODEL
# MARKET_ANALYSIS_PROVIDER_API_KEY=REPLACE_WITH_THE_SAME_GENERATED_APP_TO_APP_TOKEN
# DATABASE_URL=THE_SAME_RENDER_INTERNAL_POSTGRES_URL
# OPENAI_REQUEST_TIMEOUT_SECONDS=35
# MARKET_MODEL_MIN_VALIDATION_SAMPLES=100
# MARKET_MODEL_MAX_BRIER_SCORE=0.22
