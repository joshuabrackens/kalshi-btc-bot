# Set the same DATABASE_URL on the Web Service and Background Worker.
# Keep the actual URL secret; never commit credentials.
DATABASE_URL=postgresql://REPLACE_WITH_RENDER_INTERNAL_DATABASE_URL

# Use these on BOTH services for accurate dashboard status/config display.
PAPER_SIGNAL_SOURCE=hybrid
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Web Service only. Keep the existing webhook secret private.
GAINZALGO_WEBHOOK_SECRET=REPLACE_WITH_EXISTING_SECRET
GAINZALGO_WEBHOOK_MAX_BODY_BYTES=16384
PAPER_WORKER_ENABLED=false

# Only set this if you intentionally need manual journal/evaluation write endpoints.
# Generate a different random secret; manual routes remain disabled while blank.
PAPER_ADMIN_API_SECRET=

# Background Worker settings. Keep current risk limits; do not enable live trading.
PAPER_WORKER_INTERVAL_SECONDS=15
PAPER_MINIMUM_SCORE=65
PAPER_MAX_ENTRY_CENTS=92
PAPER_ENTRY_TARGET_MAX_CENTS=80
# Paper-only learning may conservatively tighten PAPER_ENTRY_TARGET_MAX_CENTS
# by up to 5 cents after repeated negative high-price hybrid outcomes. It never
# loosens the target or changes hard/dollar risk limits. Default: true.
PAPER_ADAPTIVE_ENTRY_TARGET_ENABLED=true
PAPER_MAX_SPREAD_CENTS=5
BTC_TREND_MONITOR_INTERVAL_SECONDS=30
BTC_TREND_MONITOR_MAX_CACHE_AGE_SECONDS=45
MAX_TRADE_DOLLARS=1.00
MAX_DAILY_LOSS_DOLLARS=10.00
